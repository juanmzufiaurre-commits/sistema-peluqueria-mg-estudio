# Supabase Postgres: pooler (runtime) y conexión directa (migraciones)
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cron: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Sitio público (enlaces de cancelación y WhatsApp)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Gateway de WhatsApp (opcional; sin esto se usan enlaces wa.me)
WHATSAPP_GATEWAY_URL=""
WHATSAPP_GATEWAY_TOKEN=""

# Emails con acceso a /admin (separados por coma). Solo ellos pueden entrar aunque haya otros usuarios en Supabase.
ADMIN_EMAILS=""

# WhatsApp gateway (Evolution API). Los tres juntos activan los envíos automáticos.
WHATSAPP_GATEWAY_INSTANCE=""
